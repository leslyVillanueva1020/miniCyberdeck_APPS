/* =========================================================
   Global Application Styling
   ========================================================= */

QWidget {
    font-family: "Pixelify Sans";
    color: #493D73;
    font-size: 14px;
}

QWidget#overviewPage,
QWidget#settingsPage {
    background-color: #FFF2DE;
    color: #493D73;
    border: 2px solid #9B88C8;
    border-radius: 14px;
}

/* =========================================================
   Labels
   ========================================================= */

QLabel {
    background-color: transparent;
    color: #493D73;
    border: none;
}

QLabel#pageTitle {
    font-family: "Pixelify Sans";
    font-size: 17px;
    font-weight: 600;
}

QLabel#settingsTitle {
    font-family: "Pixelify Sans";
    font-size: 21px;
    font-weight: 600;
}

QLabel#timeLabel {
    font-family: "Pixelify Sans";
    font-size: 36px;
    font-weight: 600;
}

QLabel#dateLabel {
    font-family: "Pixelify Sans";
    font-size: 16px;
    font-weight: 500;
}

QLabel#cardTitle {
    font-family: "Pixelify Sans";
    font-size: 15px;
    font-weight: 600;
}

QLabel#smallText {
    font-family: "Pixelify Sans";
    font-size: 12px;
    font-weight: 500;
}

/* =========================================================
   Decorative Artwork
   ========================================================= */

QLabel#fishIcon {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QLabel#deviceBadge {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
}

/* =========================================================
   Header
   ========================================================= */

QFrame#appHeader {
    background-color: #D9CEF5;
    border: 2px solid #9B88C8;
    border-radius: 12px;
}

/* =========================================================
   Overview Cards
   ========================================================= */

QFrame#clockCard {
    min-height: 100px;
    background-color: #FFF0BD;
    border: 2px solid #9B88C8;
    border-radius: 12px;
}

QFrame#batteryCard {
    background-color: #FFDCCB;
    border: 2px solid #F3A99C;
    border-radius: 12px;
}

QFrame#wifiCard {
    background-color: #D2F1EB;
    border: 2px solid #81CFC4;
    border-radius: 12px;
}

QFrame#deviceCard {
    background-color: #FFF8EF;
    border: 2px solid #B4A3D9;
    border-radius: 12px;
}

/* =========================================================
   Settings Cards
   ========================================================= */

QFrame#settingsCard {
    background-color: #FFF8EF;
    border: 2px solid #B4A3D9;
    border-radius: 12px;
}

/* =========================================================
   Buttons
   ========================================================= */

QPushButton {
    min-height: 32px;
    padding: 4px 10px;

    color: #493D73;
    background-color: #D9CEF5;

    border: 2px solid #8F7CBD;
    border-radius: 10px;

    font-family: "Pixelify Sans";
    font-size: 14px;
    font-weight: 600;
}

QPushButton#btnHome {
    background-color: #D9CEF5;
    border-color: #8F7CBD;
}

QPushButton#btnShutdown {
    color: #FFFFFF;
    background-color: #F47D87;
    border-color: #B95768;
}

QPushButton#btnSettings {
    background-color: #FFE49A;
    border-color: #C9A64D;
}

QPushButton:hover {
    border-color: #493D73;
}

QPushButton:pressed {
    padding-top: 6px;
    padding-left: 12px;
}

/* =========================================================
   Brightness Slider
   ========================================================= */

QSlider::groove:horizontal {
    height: 12px;
    background-color: #D7CFF0;
    border-radius: 6px;
}

QSlider::sub-page:horizontal {
    background-color: #35CDB8;
    border-radius: 6px;
}

QSlider::add-page:horizontal {
    background-color: #D7CFF0;
    border-radius: 6px;
}

QSlider::handle:horizontal {
    width: 20px;
    margin: -5px 0px;

    background-color: #FFE49A;
    border: 2px solid #493D73;
    border-radius: 11px;
}

/* =========================================================
   Bluetooth Toggle
   ========================================================= */

QCheckBox {
    spacing: 8px;
    color: #493D73;

    font-family: "Pixelify Sans";
    font-size: 14px;
    font-weight: 600;
}

QCheckBox::indicator {
    width: 46px;
    height: 26px;

    background-color: #D9CEF5;
    border: 2px solid #8F7CBD;
    border-radius: 13px;
}

QCheckBox::indicator:checked {
    background-color: #35CDB8;
    border-color: #287F79;
}